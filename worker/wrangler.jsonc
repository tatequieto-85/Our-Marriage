{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuestra-boda-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nuestra-boda-db",
      "database_id": "545d3203-9328-4817-80e7-4259cdf723af",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nuestra-boda-media"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "238269964490-0j25880mvbdnfmpte1u65jdnf3cc4l3h.apps.googleusercontent.com"
  }
}
